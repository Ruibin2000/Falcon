+}
+
+bool e2sm_kpm_du_meas_provider_impl::get_pusch_rf_measurement(
+    pusch_rf_metric                              metric_type,
+    const asn1::e2sm::label_info_list_l          label_info_list,
+    const std::vector<asn1::e2sm::ue_id_c>&      ues,
+    const std::optional<asn1::e2sm::cgi_c>       cell_global_id,
+    std::vector<asn1::e2sm::meas_record_item_c>& items)
+{
+  const bool is_snr = metric_type == pusch_rf_metric::snr;
+  // No node/cell aggregation is defined, and exactly one unfiltered measurement is returned per requested UE.
+  if (ues.empty() || cell_global_id.has_value() || label_info_list.size() != 1 ||
+      !has_only_no_label(label_info_list[0].meas_label)) {
+    logger.debug("Metric {} supports only UE-level measurements with NO_LABEL and no cell filter.",
+                 is_snr ? pusch_snr_metric_name : pusch_rsrp_metric_name);
+    // Report services currently consume the records even if the getter returns false.
+    for (size_t i = 0; i != ues.size(); ++i) {
+      meas_record_item_c item;
+      item.set_no_value();
+      items.push_back(item);
+    }
+    return false;
+  }
+
+  for (const auto& ue : ues) {
+    meas_record_item_c meas_record_item;
+    meas_record_item.set_no_value();
+
+    if (ue.type() == ue_id_c::types_opts::gnb_du_ue_id) {
+      const auto ue_f1ap_id = int_to_gnb_cu_ue_f1ap_id(ue.gnb_du_ue_id().gnb_cu_ue_f1ap_id);
+      const auto ue_index   = f1ap_ue_id_provider.get_ue_index(ue_f1ap_id);
+      if (ue_index != du_ue_index_t::INVALID_DU_UE_INDEX) {
+        // The snapshot vector is dense, but internal UE indices may have gaps after UE removal.
+        auto metric = std::find_if(last_ue_metrics.begin(), last_ue_metrics.end(), [ue_index](const auto& candidate) {
+          return candidate.ue_index == ue_index;
+        });
+        if (metric != last_ue_metrics.end()) {
+          const float value = is_snr ? metric->pusch_snr_db : metric->pusch_rsrp_db;
+          const bool has_sample = !is_snr || metric->nof_pusch_snr_reports > 0;
+          if (has_sample && std::isfinite(value)) {
+            // RSRP uses -infinity for missing data. SNR needs a count to distinguish missing from measured 0 dB.
+            meas_record_item.set_real().value = value;
+          }
+        }
+      }
+    }
+    // Preserve request order and cardinality, including disconnected or unmeasured UEs.
+    items.push_back(meas_record_item);
+  }
+
+  return true;
 }
 
