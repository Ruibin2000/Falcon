+                           .enable_rrc_metrics  = cfg.metrics.layers_cfg.enable_rrc_metrics || cfg.metrics.layers_cfg.enable_ue_identity,
                            .ue                  = cfg.ue},
          ue_manager_dependencies{.timers         = *cfg.services.timers,
