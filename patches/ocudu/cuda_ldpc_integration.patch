+    const auto& values = row.meas_report.meas_data[0].meas_record;
+    for (unsigned j = 0; j != 2; ++j) {
+      EXPECT_EQ(values[j].type(), i == 2 ? meas_record_item_c::types::no_value : meas_record_item_c::types::real);
+    }
+    if (i != 2) {
