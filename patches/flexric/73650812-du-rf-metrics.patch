+
+static volatile sig_atomic_t stop_requested;
+
+static void request_stop(int signal_number)
+{
+  (void)signal_number;
+  stop_requested = 1;
+}
+
+static bool get_subscription_capacity(size_t nodes, size_t configurations, size_t* capacity)
+{
+  *capacity = 0;
+  if (configurations != 0 && nodes > SIZE_MAX / configurations)
+    return false;
+  size_t count = nodes * configurations;
+  if (count > SIZE_MAX / sizeof(sm_ans_xapp_t))
+    return false;
+  *capacity = count;
+  return true;
+}
+
+/* Explicit monitor limits; longer ASN.1 extension names are not rendered. */
+enum { max_kpm_list_items = 65535, max_kpm_name_bytes = 150 };
+
+static bool valid_kpm_measurement_lists(kpm_ind_msg_format_1_t const* report)
+{
+  return report->meas_data_lst_len > 0 && report->meas_data_lst_len <= max_kpm_list_items &&
+         report->meas_data_lst != NULL && report->meas_info_lst_len <= max_kpm_list_items &&
+         (report->meas_info_lst_len == 0 || report->meas_info_lst != NULL);
+}
+
+static bool valid_kpm_measurement_records(meas_data_lst_t const* row)
+{
+  return row->meas_record_len > 0 && row->meas_record_len <= max_kpm_list_items && row->meas_record_lst != NULL;
+}
+
+static void print_kpm_metric_context(global_e2_node_id_t const* node,
+                                     uint64_t header_time,
+                                     const char* ue_key, uint64_t ue_id,
+                                     size_t sample_index)
+{
+  printf("plmn=%03u-%0*u mnc_digits=%u node_type=%d node_id=%" PRIu32 " node_id_unused=%" PRIu32,
+         (unsigned)node->plmn.mcc, (int)node->plmn.mnc_digit_len, (unsigned)node->plmn.mnc,
+         (unsigned)node->plmn.mnc_digit_len, node->type, node->nb_id.nb_id, node->nb_id.unused);
+  if (node->cu_du_id != NULL)
+    printf(" cu_du_id=%" PRIu64, *node->cu_du_id);
+  else
+    printf(" cu_du_id=n/a");
+#if defined(KPM_V3_00)
+  printf(" %s=%" PRIu64 " header_time_us=%" PRIu64 " sample_idx=%zu ",
+         ue_key, ue_id, header_time, sample_index);
+#else
+  printf(" %s=%" PRIu64 " header_time_s=%" PRIu64 " sample_idx=%zu ",
+         ue_key, ue_id, header_time, sample_index);
+#endif
+}
+
+static void print_kpm_rf_trace(global_e2_node_id_t const* node, uint64_t header_time,
+                              const char* ue_key, uint64_t ue_id, size_t sample_index,
+                              const char* name, size_t name_len, const char* unit,
+                              meas_record_lst_t const* record, bool incomplete)
+{
+  /* Keep a trace row intact alongside SDK output from other threads. */
+  flockfile(stdout);
+  printf("RF_TRACE ");
+  print_kpm_metric_context(node, header_time, ue_key, ue_id, sample_index);
+  printf("metric=%.*s record_type=", (int)name_len, name);
+  switch (record->value) {
+    case REAL_MEAS_VALUE:
+      if (isfinite(record->real_val))
+        printf("REAL value=%.17g", record->real_val);
+      else
+        printf("REAL value=n/a reason=non_finite_REAL");
+      break;
+    case NO_VALUE_MEAS_VALUE:
+      printf("noValue value=n/a");
+      break;
+    case INTEGER_MEAS_VALUE:
+      printf("INTEGER value=n/a reason=expected_REAL");
+      break;
+    default:
+      printf("unsupported value=n/a reason=unsupported_value_type");
+  }
+  printf(" unit=%s incomplete=%s\n", unit, incomplete ? "true" : "false");
+  funlockfile(stdout);
+}

