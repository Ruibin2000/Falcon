# Local SIM authentication credentials and copies or backups.
sim_du*_credentials.txt*

# Local editor workspace.
/Falcon.code-workspace

# Detailed experiment captures and working records stay local.
/docs/experiments/evidence/
/docs/experiments/records/
/docs/experiments/documentation_relocation.json

# Publish readable reports and their selected presentation figures.
# Keep raw data and other generated files out of the report directories.
/docs/experiments/reports/*
!/docs/experiments/reports/*.md
!/docs/experiments/reports/assets/
/docs/experiments/reports/assets/**/*
!/docs/experiments/reports/assets/**/
!/docs/experiments/reports/assets/**/*.png
!/docs/experiments/reports/assets/**/*.svg
!/docs/experiments/reports/assets/**/*.pdf

# Former experiment archive locations; prevent accidental reintroduction.
/docs/evidence/
/docs/reports/
/docs/e2sm-kpm/2026-*
/docs/troubleshooting/2026-*
/docs/notes/e2sm_kpm_du_rf_metrics_semantics.md
/docs/networking/dual_ue_subnets.md

# Local runtime/verification output directories, if created inside this repo.
/artifacts/
/captures/
/evidence/
/logs/
/outputs/
/results/
/runs/
/tmp/
*.log
*.log.*
*.pcap
*.pcapng

# Python runtime caches; source fixtures and interface examples remain tracked.
__pycache__/
*.py[cod]
